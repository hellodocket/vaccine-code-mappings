{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "description": "A single top-level `mappings` array holding every CDC NDC row (one entry per row). Consumers build their own lookups (e.g. by Unit of Sale or Unit of Use NDC11). Each row carries its own cvx_code, since a single NDC can reference multiple CVX codes.",
  "required": [
    "mappings"
  ],
  "additionalProperties": false,
  "properties": {
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cvx_code": {
            "type": ["string", "null"]
          },
          "sale_ndc11": {
            "type": ["string", "null"]
          },
          "use_ndc11": {
            "type": ["string", "null"]
          },
          "no_use_ndc": {
            "type": "boolean"
          },
          "proprietary_name": {
            "type": ["string", "null"]
          },
          "labeler": {
            "type": ["string", "null"]
          },
          "mvx_code": {
            "type": ["string", "null"]
          },
          "start_date": {
            "type": ["string", "null"]
          },
          "end_date": {
            "type": ["string", "null"]
          },
          "sale_gtin": {
            "type": ["string", "null"]
          },
          "use_gtin": {
            "type": ["string", "null"]
          },
          "sale_last_updated": {
            "type": ["string", "null"]
          },
          "use_last_updated": {
            "type": ["string", "null"]
          }
        },
        "required": [
          "cvx_code",
          "sale_ndc11",
          "use_ndc11",
          "no_use_ndc",
          "proprietary_name",
          "labeler",
          "mvx_code",
          "start_date",
          "end_date",
          "sale_gtin",
          "use_gtin",
          "sale_last_updated",
          "use_last_updated"
        ],
        "additionalProperties": false
      }
    }
  }
}
